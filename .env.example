APP_NAME=企业知识库智能助手
DATABASE_PATH=storage/app_nojournal.sqlite3
UPLOAD_DIR=uploads
VECTOR_STORE_PATH=storage/vector_store.json

DATABASE_URL=postgresql+psycopg://rag:rag_password@127.0.0.1:5432/rag
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=enterprise_knowledge_bge_m3_chunks

# 可选值：local、openai_compatible
# DeepSeek 使用兼容 OpenAI 的接口格式，基础地址为 https://api.deepseek.com
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# 可选值：local、bge_m3、openai_compatible、hash
# local/bge_m3 会使用 transformers + torch 在本地加载真实 BAAI/bge-m3，维度保持 1024。
# hash 仅用于无模型依赖的调试，不建议用于正式检索效果演示。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
BGE_M3_USE_FP16=false
BGE_M3_BATCH_SIZE=12
BGE_M3_MAX_LENGTH=8192

DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
DEFAULT_RERANK=false
DEFAULT_MIN_SCORE=0.08

VECTOR_CANDIDATE_MULTIPLIER=4
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3
BM25_K1=1.5
BM25_B=0.75
RERANK_ORIGINAL_SCORE_WEIGHT=0.7
RERANK_TERM_COVERAGE_WEIGHT=0.3
RERANK_PROVIDER=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30
LOCAL_ANSWER_MIN_SCORE=0.08
LOCAL_ANSWER_RELATIVE_SCORE=0.55
LOCAL_ANSWER_MAX_CONTEXTS=3
LOCAL_ANSWER_SNIPPET_LENGTH=260
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_TITLE_LENGTH=40
ERROR_MESSAGE_MAX_LENGTH=2000
DEDUPE_KEY_LENGTH=500
MAX_LOG_LIMIT=200
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
EMBEDDING_TIMEOUT_SECONDS=60
LOCAL_NO_PROXY_HOSTS=127.0.0.1,localhost,::1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
AUTH_TOKEN_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
