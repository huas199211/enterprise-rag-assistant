APP_NAME=Enterprise Knowledge Assistant
DATABASE_PATH=storage/app_nojournal.sqlite3
UPLOAD_DIR=uploads
VECTOR_STORE_PATH=storage/vector_store.json

DATABASE_URL=postgresql+psycopg://rag:rag_password@127.0.0.1:5432/rag
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=enterprise_knowledge_bge_m3_chunks

# local | openai_compatible
# DeepSeek 使用 OpenAI-compatible API，base_url 为 https://api.deepseek.com
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# local | openai_compatible
# 中文知识库推荐 BAAI/bge-m3。没有 embedding API key 时使用本地 fallback，但维度保持 1024。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
DEFAULT_RERANK=false
DEFAULT_MIN_SCORE=0.08
